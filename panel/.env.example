# Base URL of the Paper plugin's embedded admin HTTP API.
# Defaults to http://127.0.0.1:8081 if unset.
PLUGIN_API_URL=http://127.0.0.1:8081

# Port/host for this SvelteKit app's own Node server (adapter-node). Optional -
# see https://svelte.dev/docs/kit/adapter-node for the full list of supported vars.
# PORT=3000
# HOST=0.0.0.0

# The mcvpn client-facing address of the Paper server (i.e. the public
# host/port a Minecraft client actually connects to) -- NOT the admin API
# above. Only used client-side to fill in the "Download config" button's
# generated config.toml; the panel makes no network call to this address.
PUBLIC_MC_HOST=127.0.0.1
PUBLIC_MC_PORT=25565
